# LLM (server-only; leave blank to disable a provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AGENT_PROVIDER_ORDER=groq,gemini,openrouter
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GEMINI_AGENT_MODEL=gemini-3-flash-preview
OPENROUTER_AGENT_MODEL=deepseek/deepseek-v4-flash
GROQ_STT_MODEL=whisper-large-v3-turbo
# Pipeline and server only. Never prefix a key with NEXT_PUBLIC_.
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
NASA_API_KEY=
EARTHDATA_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CRON_SECRET=
REVALIDATE_SECRET=
# Public asset host. Leave unset to use the project R2 URL. Set to off to stay on same-origin 2K files.
NEXT_PUBLIC_ASSET_BASE_URL=
