{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3000/en",
        "http://127.0.0.1:3000/ar",
        "http://127.0.0.1:3000/en/listen?demo=1",
        "http://127.0.0.1:3000/en/quiz",
        "http://127.0.0.1:3000/en/guide",
        "http://127.0.0.1:3000/en/tutorial"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
