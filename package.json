{
  "name": "earth-listens",
  "version": "0.1.0",
  "private": true,
  "description": "Earth Listens: a voice-first sonification of NASA Earth data for blind and low-vision listeners.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "data:samples": "tsx scripts/generate-samples.ts",
    "data:explanations": "tsx scripts/generate-explanations.ts",
    "data:quiz": "tsx scripts/generate-quiz-truth.ts",
    "data:schemas": "tsx scripts/export-json-schemas.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "py:test": "cd pipeline && python3 -m pytest"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "globe.gl": "2.46.2",
    "gsap": "3.15.1",
    "kokoro-js": "1.2.1",
    "lenis": "1.3.27",
    "motion": "14.13.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "tone": "15.1.22",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
